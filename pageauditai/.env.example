# PostgreSQL — Prisma
#
# Runtime (Next.js, serverless): use Supabase Transaction pooler (port 6543) with:
#   ?schema=pageauditai&pgbouncer=true&sslmode=require
# Pooler user is often `postgres.<project-ref>`; keep this as DATABASE_URL.
#
# Migrations only: Prisma uses DIRECT_URL (direct host, port 5432). Use the same DB
# password as DATABASE_URL; user is usually `postgres.<project-ref>` (same as pooler),
# host `db.<project-ref>.supabase.co`, no `pgbouncer` flag.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=pageauditai&pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=pageauditai&sslmode=require"
# If PASSWORD contains @, encode it as %40 (e.g. myp%40ssword) so the URL parses correctly.

# Auth.js — required in production. Generate with: openssl rand -base64 32
# If unset in development, a built-in dev fallback is used (not for production).
AUTH_SECRET="replace-with-a-long-random-string"

# Public app URL (used by Auth.js for redirects). No trailing slash.
AUTH_URL="http://localhost:3000"

# Landing page "Book a Demo" / "Contact Sales" mailto target (optional; defaults to support@pageauditai.com).
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Local billing simulation only: skips Razorpay/Lemon Squeezy API calls and completes checkout in-app.
# Never active when NODE_ENV=production (runtime or build with BILLING_TEST_MODE check at startup).
BILLING_TEST_MODE="false"

# Vercel Cron: set the same value in Vercel → Settings → Cron Jobs (CRON_SECRET).
# GET /api/cron/keyword-refresh requires `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# Optional: separate secret for signed billing callback payloads (defaults to AUTH_SECRET).
BILLING_STATE_SECRET=""

# After migrations, seed the local admin user: npm run db:seed
# See prisma/ADMIN-SEED.md for defaults and how to rotate credentials.
